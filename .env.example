# Copy to .env and fill in. .env is gitignored — never commit real values.

# Katana MRP — generate in the Katana web app: Settings -> API
KATANA_API_KEY=
KATANA_API_BASE=https://api.katanamrp.com/v1

# NTP BigCommerce — Advanced Settings -> API Accounts -> Create V2/V3 API Token
# Scopes needed: Products (read-only), Product info (read-only), Product images (read-only)
BC_STORE_HASH=
BC_API_BASE=https://api.bigcommerce.com/stores/YOUR_STORE_HASH/v3
BC_CLIENT_ID=
BC_ACCESS_TOKEN=

# Fishbowl ERP - MSRP source (product.price via /api/data-query SQL endpoint)
# Reuse an already-approved integrated app (Setup -> Integrated Apps in Fishbowl UI)
FISHBOWL_URL=http://your-fishbowl-host:3595
FISHBOWL_USER=
FISHBOWL_PASS=
FISHBOWL_APP_NAME=ChromeOutletLister
FISHBOWL_APP_ID=4821
